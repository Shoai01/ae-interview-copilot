# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (required — there is no fallback database) ---
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viva_copilot

# --- Security ---
# Required unless DEV_MODE=true (which uses an ephemeral key — local dev only).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# DEV_MODE=true

# --- Initial admin (created on first start if no admin exists) ---
SEED_ADMIN_USERNAME=admin
# If left empty a one-time password is generated and printed to the console,
# and the admin must change it on first login.
SEED_ADMIN_PASSWORD=

# --- Google Vertex AI (question generation, evaluation, embeddings) ---
# Path to a service-account JSON key. Keep the file out of git.
GOOGLE_APPLICATION_CREDENTIALS=./vertex-key.json

# --- Deepgram (live speech-to-text; the backend mints short-lived browser tokens) ---
DEEPGRAM_API_KEY=

# --- Exam integrity: automatic submit ---
# Every proctoring flag episode scores points; when a session's total reaches
# INTEGRITY_AUTO_SUBMIT_POINTS the exam is submitted automatically (the trainer
# still decides pass/fail). All values are optional — the defaults are shown.
# 0 turns the whole feature off.
INTEGRITY_AUTO_SUBMIT_ENABLED=1
# Total points at which the exam is auto-submitted.
INTEGRITY_AUTO_SUBMIT_POINTS=10
# Points at which the candidate gets a one-time "final warning" toast (0 = never).
INTEGRITY_FINAL_WARNING_POINTS=6
# Points per episode of each flag type (0 = never counts toward auto-submit).
INTEGRITY_POINTS_FACE_MISMATCH=5
INTEGRITY_POINTS_MULTIPLE_FACES=3
INTEGRITY_POINTS_TAB_SWITCH=2
INTEGRITY_POINTS_FULLSCREEN_EXIT=2
INTEGRITY_POINTS_NO_FACE=1
INTEGRITY_POINTS_BACKGROUND_NOISE=0
# An episode scores nothing until it has lasted this many seconds, per flag type.
# NO_FACE defaults to 10 so glancing away briefly is free; the rest default to 0.
INTEGRITY_MIN_SECONDS_NO_FACE=10
# INTEGRITY_MIN_SECONDS_MULTIPLE_FACES=0
# INTEGRITY_MIN_SECONDS_TAB_SWITCH=0
# INTEGRITY_MIN_SECONDS_FULLSCREEN_EXIT=0
# INTEGRITY_MIN_SECONDS_FACE_MISMATCH=0
# While an episode stays open, add INTEGRITY_ESCALATE_POINTS for every further
# INTEGRITY_ESCALATE_EVERY_SECONDS (so staying out of fullscreen keeps costing).
# Set INTEGRITY_ESCALATE_EVERY_SECONDS=0 to charge each episode once only.
INTEGRITY_ESCALATE_EVERY_SECONDS=30
INTEGRITY_ESCALATE_POINTS=1
# How often (seconds, minimum 2) the exam page asks the server for its status.
INTEGRITY_POLL_SECONDS=5

# --- SMTP (optional — if SMTP_HOST is empty, emails are printed to the console) ---
SMTP_HOST=
# 465 = implicit SSL, anything else = STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
