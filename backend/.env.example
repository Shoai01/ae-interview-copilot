# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (required — there is no fallback database) ---
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viva_copilot

# --- Security ---
# Required unless DEV_MODE=true (which uses an ephemeral key — local dev only).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# DEV_MODE=true

# --- Initial admin (created on first start if no admin exists) ---
SEED_ADMIN_USERNAME=admin
# If left empty a one-time password is generated and printed to the console,
# and the admin must change it on first login.
SEED_ADMIN_PASSWORD=

# --- Google Vertex AI (question generation, evaluation, embeddings) ---
# Path to a service-account JSON key. Keep the file out of git.
GOOGLE_APPLICATION_CREDENTIALS=./vertex-key.json

# --- Deepgram (live speech-to-text; the backend mints short-lived browser tokens) ---
DEEPGRAM_API_KEY=

# --- SMTP (optional — if SMTP_HOST is empty, emails are printed to the console) ---
SMTP_HOST=
# 465 = implicit SSL, anything else = STARTTLS
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
