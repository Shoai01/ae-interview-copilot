# Copy to .env.local if you need to override the defaults. Everything here is optional.

# Backend base URL. Default: http://localhost:8000 when served from localhost,
# otherwise "/api" on the same origin (reverse-proxy setup).
# VITE_API_URL=http://localhost:8000

# Live transcription tuning (Deepgram)
# VITE_DEEPGRAM_MODEL=nova-3
# VITE_DEEPGRAM_LANGUAGE=en-IN
# VITE_DEEPGRAM_MIN_FINAL_CONFIDENCE=0.45
# Extra comma-separated vocabulary hints, added to the built-in product terms
# VITE_DEEPGRAM_KEYTERMS=
